{
    "workspace.rootPatterns": [".root", ".git", ".hg", ".svn"],
    "workspace.ignoredFolders": ["$HOME", "$HOME/.cargo/**", "$HOME/.rustup/**", "**/.git", "**/.clangd", ".svn", ".hg", ".cache"],
    "workspace.ignoredFiletypes": ["bin", "so", "a", "o", "git", "gitcommit", "log", "sql", "mysql", "help", "man", "fugitive", "coc"],
    "diagnostic.enable": true,
    "diagnostic.enableMessage": true,
    "diagnostic.checkCurrentLine": true,
    "diagnostic.locationlistLevel": "warning",
    "diagnostic.locationlistUpdate": true,
    "diagnostic.level": "warning",
    "diagnostic.signLevel": "warning",
    "diagnostic.enableSign": false,
    "diagnostic.errorSign": "⛔",
    "diagnostic.warningSign": "⚠️",
    "diagnostic.hintSign": "💡",
    "diagnostic.infoSign": "ℹ️",
    "suggest.autoTrigger": "always",
    "suggest.enableFloat": false,
    "suggest.triggerAfterInsertEnter": true,
    "suggest.minTriggerInputLength": 3,
    "suggest.enablePreselect": true,
    "suggest.labelMaxLength": 100,
    "suggest.removeDuplicateItems": true,
    "suggest.snippetIndicator": "⋯",
    "suggest.detailField": "preview",
    "suggest.noselect": false,
    "suggest.timeout": 4000,
    "inlayHint.enable": true,
    "inlayHint.enableParameter": false,
    "signature.enable": true,
    "signature.hideOnTextChange": true,
    "signature.triggerSignatureWait": 300,
    "codeLens.enable": true,
    "languageserver.revealOutputChannelOn": "error",
    "languageserver.progressOnInitialization": true,
    "outline.splitCommand": "botright 40vs",
    "outline.checkBufferSwitch": false,
    "outline.sortBy": "position",
    "outline.expandLevel": 2,
    "extensions.updateCheck": "weekly",
    "coc.preferences.formatOnSaveFiletypes": ["lua", "python", "c", "cpp", "json"],
    "Lua.diagnostics.disable": ["undefined-global", "lowercase-global", "redundant-value", "unused-local"],
    "Lua.diagnostics.globals": ["vim", "vim.api"],
    "clangd.path": "clangd",
    "clangd.arguments": ["--header-insertion=never", "--background-index", "--fallback-style=llvm", "-j=8"],
    "clangd.fallbackFlags": ["-std=c++17"],
    "c.source.fixAll": ["clang-format"],
    "cpp.source.fixAll": ["clang-format"],
    "pyright.organizeimports.provider": "pyright",
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.autoSearchPaths": true,
    "python.analysis.useLibraryCodeForTypes": true,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.autoImportCompletions": true,
    "rust-analyzer.server.path": "rust-analyzer",
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.cargo.features": "all",
    "rust-analyzer.inlayHints.typeHints.enable": true,
    "rust-analyzer.inlayHints.parameterHints.enable": true,
    "rust-analyzer.inlayHints.chainingHints.enable": true,
    "rust-analyzer.completion.autoimport.enable": true,
    "rust-analyzer.hover.documentation.enable": true,
    "rust-analyzer.lens.enable": true,
    "rust-analyzer.lens.run.enable": true,
    "rust-analyzer.lens.debug.enable": true,
    "rust-analyzer.lens.implementations.enable": true,
    "rust-analyzer.updates.checkOnStartup": false
}
